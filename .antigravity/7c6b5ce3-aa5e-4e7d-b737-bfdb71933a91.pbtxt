  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport {\n  Palette,\n  Type,\n  Layout,\n  CheckCircle2,\n  XCircle,\n  Sliders,\n  Sparkles,\n  Layers,\n  ArrowRight,\n  Eye,\n  ShieldAlert,\n  Zap,\n} from \'lucide-react\';\nimport { useStock } from \'../context/StockContext\';\nimport { THEME_CONFIGS } from \'./ThemeClasses\';\nimport { ThemeStyle } from \'../types\';\n\nexport const DesignSystemView: React.FC = () => {\n  const { theme, setTheme, setViewMode, setActiveTab } = useStock();\n\n  const currentThemeConfig = THEME_CONFIGS[theme];\n\n  const colorTokens = [\n    {\n      role: \'60% Toile Neutre Principale (Canvas)\',\n      token: \'bg-slate-50 / #F8FAFC\',\n      hex: \'#F8FAFC\',\n      usage: \'Fond de page, respiration visuelle, z\303\251ro distraction.\',\n      ratio: \'21:1 (Noir sur Blanc)\',\n    },\n    {\n      role: \'30% Surfaces & Cartes Structurelles\',\n      token: \'bg-white / #FFFFFF + border-slate-200\',\n      hex: \'#FFFFFF\',\n      usage: \'Cartes \303\240 simple \303\251l\303\251vation, tableaux, en-t\303\252tes et modales.\',\n      ratio: \'18.4:1\',\n    },\n    {\n      role: \'10% Accent Principal (Cobalt Bleu)\',\n      token: \'bg-blue-600 / #2563EB\',\n      hex: \'#2563EB\',\n      usage: \'Boutons d\342\200\231action primaires, \303\251tat actif de navigation, focus rings.\',\n      ratio: \'4.8:1 (WCAG AA valid\303\251)\',\n    },\n    {\n      role: \'S\303\251mantique Flux : Entr\303\251e / Conforme\',\n      token: \'text-emerald-700 / #047857\',\n      hex: \'#047857\',\n      usage: \'R\303\251ceptions de stock, niveaux conformes, synchronisation r\303\251ussie.\',\n      ratio: \'5.2:1 (Lisibilit\303\251 optimale)\',\n    },\n    {\n      role: \'S\303\251mantique Flux : Seuil Critique\',\n      token: \'text-amber-700 / #B45309\',\n      hex: \'#B45309\',\n      usage: \'Stock approchant le seuil de r\303\251approvisionnement, attention requise.\',\n      ratio: \'4.7:1\',\n    },\n    {\n      role: \'S\303\251mantique Flux : Rupture Imm\303\251diate\',\n      token: \'text-rose-700 / #BE123C\',\n      hex: \'#BE123C\',\n      usage: \'Stock \303\240 0 unit\303\251, blocage de vente, avertissement destructif.\',\n      ratio: \'5.6:1\',\n    },\n  ];\n\n  return (\n    <div className=\"p-8 space-y-12 max-w-6xl mx-auto\">\n      {/* Title & Introduction */}\n      <div>\n        <div className=\"flex items-center gap-2 text-xs font-bold text-blue-600 uppercase tracking-widest mb-1.5\">\n          <Palette className=\"w-4 h-4\" />\n          <span>Charte Graphique & Sp\303\251cifications UI</span>\n        </div>\n        <h1 className=\"text-3xl font-extrabold tracking-tight text-slate-900\">\n          Syst\303\250me de Design & Identit\303\251 Visuelle StockFlow\n        </h1>\n        <p className=\"text-sm text-slate-600 mt-2 max-w-3xl leading-relaxed\">\n          Cette planche de conception pr\303\251sente les choix typographiques, la grille modulaire 1440px, la r\303\250gle Z\303\251ro-Pill pour les m\303\251tadonn\303\251es et les 4 univers stylistiques con\303\247us pour s\'adapter \303\240 la personnalit\303\251 de votre commerce.\n        </p>\n      </div>\n\n      {/* 1. Theme Switcher Exhibition */}\n      <div className=\"space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <h2 className=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n            <Sparkles className=\"w-5 h-5 text-blue-600\" />\n            <span>1. Les 4 Univers Stylistiques D\303\251velopp\303\251s</span>\n          </h2>\n          <span className=\"text-xs text-slate-400\">\n            Cliquez pour tester l\'impact visuel en direct sur l\'interface\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n          {(Object.keys(THEME_CONFIGS) as ThemeStyle[]).map((key) => {\n            const cfg = THEME_CONFIGS[key];\n            const isSelected = theme === key;\n            return (\n              <div\n                key={key}\n                onClick={() => setTheme(key)}\n                className={`p-5 rounded-2xl border-2 cursor-pointer transition-all duration-200 relative bg-white flex flex-col justify-between ${\n                  isSelected\n                    ? \'border-blue-600 shadow-md ring-2 ring-blue-600/10\'\n                    : \'border-slate-200 hover:border-slate-300 hover:shadow-xs\'\n                }`}\n              >\n                <div>\n                  <div\n                    className={`h-16 w-full rounded-xl bg-gradient-to-r ${cfg.previewSample} mb-4 flex items-center justify-center text-white font-mono text-xs font-bold shadow-inner`}\n                  >\n                    {cfg.name.split(\' \')[0]}\n                  </div>\n                  <h3 className=\"text-sm font-bold text-slate-900\">{cfg.name}</h3>\n                  <p className=\"text-xs font-medium text-blue-600 mt-0.5\">{cfg.subtitle}</p>\n                  <p className=\"text-xs text-slate-500 mt-2 leading-relaxed\">\n                    {cfg.tagline}\n                  </p>\n                </div>\n\n                <div className=\"mt-4 pt-3 border-t border-slate-100 flex items-center justify-between\">\n                  <span\n                    className={`text-[11px] font-semibold ${\n                      isSelected ? \'text-blue-600\' : \'text-slate-400\'\n                    }`}\n                  >\n                    {isSelected ? \'\342\227\217 Th\303\250me Actif\' : \'S\303\251lectionner\'}\n                  </span>\n                  <div\n                    className=\"w-4 h-4 rounded-full border border-slate-300\"\n                    style={{ backgroundColor: cfg.accentColor }}\n                  />\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* 2. Color Palette & 60-30-10 Rule */}\n      <div className=\"space-y-4\">\n        <h2 className=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n          <Palette className=\"w-5 h-5 text-indigo-600\" />\n          <span>2. Palette Chromatique & R\303\250gle des Proportions (60-30-10)</span>\n        </h2>\n        <p className=\"text-xs text-slate-500\">\n          Pour \303\251viter la fatigue oculaire lors des inventaires prolong\303\251s, les contrastes sont strictement calibr\303\251s selon la norme WCAG AA.\n        </p>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n          {colorTokens.map((item, idx) => (\n            <div\n              key={idx}\n              className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs space-y-3\"\n            >\n              <div className=\"flex items-center gap-3\">\n                <div\n                  className=\"w-10 h-10 rounded-lg border border-slate-200 shadow-2xs shrink-0\"\n                  style={{ backgroundColor: item.hex }}\n                />\n                <div className=\"min-w-0\">\n                  <div className=\"text-xs font-bold text-slate-900 truncate\">\n                    {item.role}\n                  </div>\n                  <div className=\"text-[11px] font-mono text-slate-400\">\n                    {item.hex} \302\267 {item.token.split(\' \')[0]}\n                  </div>\n                </div>\n              </div>\n              <p className=\"text-xs text-slate-600 leading-relaxed\">{item.usage}</p>\n              <div className=\"pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400\">\n                <span>Contraste :</span>\n                <span className=\"font-mono text-emerald-700 font-semibold\">{item.ratio}</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* 3. Typography & Tabular Figures */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200 space-y-6\">\n        <h2 className=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n          <Type className=\"w-5 h-5 text-blue-600\" />\n          <span>3. Discipline Typographique & Chiffres Tabulaires (Tabular-Nums)</span>\n        </h2>\n        <p className=\"text-xs text-slate-500 -mt-3\">\n          Le principe du 2+1 : une police humaine lisible pour la narration (<strong>Plus Jakarta Sans</strong>) combin\303\251e avec une police m\303\251canique pour l\'alignement d\303\251cimal des stocks (<strong>JetBrains Mono</strong>).\n        </p>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          <div className=\"p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-3\">\n            <span className=\"text-xs font-bold text-slate-700 block\">\n              Plus Jakarta Sans \342\200\224 Structure & Hi\303\251rarchie\n            </span>\n            <div className=\"space-y-1\">\n              <div className=\"text-2xl font-bold text-slate-900\">\n                StockFlow Logistique & Vente\n              </div>\n              <div className=\"text-sm font-semibold text-slate-700\">\n                Sous-titres & Libell\303\251s de Navigation\n              </div>\n              <div className=\"text-xs text-slate-500\">\n                Corps de texte fluide et net, \303\251vitant le rendu g\303\251n\303\251rique d\'Inter tout en assurant une lisibilit\303\251 maximale \303\240 13px\342\200\22314px.\n              </div>\n            </div>\n          </div>\n\n          <div className=\"p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-3 font-mono\">\n            <span className=\"text-xs font-bold text-slate-700 block font-sans\">\n              JetBrains Mono tabular-nums \342\200\224 Pr\303\251cision Financi\303\250re & Stock\n            </span>\n            <div className=\"space-y-1 text-xs text-slate-800\">\n              <div className=\"flex justify-between py-0.5 border-b border-slate-200\">\n                <span>SKU-001  Oxford Chemise</span>\n                <span className=\"tabular-nums font-bold\">28 pcs \302\267 1 820.00 \342\202\254</span>\n              </div>\n              <div className=\"flex justify-between py-0.5 border-b border-slate-200\">\n                <span>SKU-002  Pantalon Chino</span>\n                <span className=\"tabular-nums font-bold\">06 pcs \302\267   474.00 \342\202\254</span>\n              </div>\n              <div className=\"flex justify-between py-0.5\">\n                <span>SKU-003  Casque Audio NC</span>\n                <span className=\"tabular-nums font-bold\">14 pcs \302\267 2 086.00 \342\202\254</span>\n              </div>\n            </div>\n            <p className=\"text-[11px] text-slate-400 font-sans mt-2\">\n              Chaque chiffre occupe exactement la m\303\252me largeur physique, garantissant un alignement vertical sans d\303\251calage.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* 4. Zero-Pill vs Slop Rules */}\n      <div className=\"bg-white p-6 rounded-2xl border border-slate-200 space-y-6\">\n        <h2 className=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n          <ShieldAlert className=\"w-5 h-5 text-amber-600\" />\n          <span>4. R\303\250gle du Z\303\251ro-Pill & \303\211limination du Bruit Visuel</span>\n        </h2>\n        <p className=\"text-xs text-slate-500 -mt-3\">\n          Les interfaces g\303\251n\303\251riques empilent souvent des \302\253 pilules \302\273 multicolores pour chaque m\303\251tadonn\303\251e. StockFlow applique une discipline \303\251ditoriale \303\251pur\303\251e.\n        </p>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 text-xs\">\n          {/* Bad Practice */}\n          <div className=\"p-4 rounded-xl border border-rose-200 bg-rose-50/30 space-y-3\">\n            <div className=\"flex items-center gap-1.5 text-rose-700 font-bold\">\n              <XCircle className=\"w-4 h-4\" />\n              <span>\303\200 \303\211VITER (AI Slop & Surcharge de Badges)</span>\n            </div>\n            <div className=\"p-3 bg-white rounded-lg border border-rose-200 flex items-center gap-2 flex-wrap\">\n              <span className=\"bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full font-bold\">\n                CHEMISE\n              </span>\n              <span className=\"bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full\">\n                EN STOCK\n              </span>\n              <span className=\"bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full\">\n                RAYON H-02\n              </span>\n              <span className=\"bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full\">\n                MAJ 14:00\n              </span>\n            </div>\n            <p className=\"text-slate-500 text-[11px]\">\n              Effet \302\253 sapin de No\303\253l \302\273 : les yeux sont assaillis par les bordures et les couleurs, masquant l\'information utile.\n            </p>\n          </div>\n\n          {/* Good Practice (StockFlow Standard) */}\n          <div className=\"p-4 rounded-xl border border-emerald-200 bg-emerald-50/30 space-y-3\">\n            <div className=\"flex items-center gap-1.5 text-emerald-800 font-bold\">\n              <CheckCircle2 className=\"w-4 h-4\" />\n              <span>STANDARD STOCKFLOW (Typographie \303\211pur\303\251e)</span>\n            </div>\n            <div className=\"p-3 bg-white rounded-lg border border-slate-200 flex items-center gap-2 text-slate-600\">\n              <span className=\"font-semibold text-slate-900\">Chemise Oxford</span>\n              <span className=\"text-slate-300\">\302\267</span>\n              <span>Rayon H-02</span>\n              <span className=\"text-slate-300\">\302\267</span>\n              <span className=\"font-mono tabular-nums text-emerald-700 font-bold\">28 en stock</span>\n              <span className=\"text-slate-300\">\302\267</span>\n              <span className=\"text-slate-400 font-mono\">14:00</span>\n            </div>\n            <p className=\"text-slate-500 text-[11px]\">\n              Lisibilit\303\251 imm\303\251diate : les s\303\251parateurs discrets (\302\267) structurent la phrase sans aucune bo\303\256te artificielle.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* 5. Direct View Mode Actions */}\n      <div className=\"p-6 bg-slate-900 text-white rounded-2xl flex flex-col md:flex-row md:items-center justify-between gap-6 shadow-xl\">\n        <div>\n          <h3 className=\"text-lg font-bold\">Pr\303\252t \303\240 explorer les rendus d\'interface ?</h3>\n          <p className=\"text-xs text-slate-300 mt-1\">\n            Basculez instantan\303\251ment entre la vue en cartes visuelles boutique, la grille haute densit\303\251 ou le tableau Kanban.\n          </p>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={() => {\n              setViewMode(\'cards\');\n              setActiveTab(\'inventory\');\n            }}\n            className=\"px-4 py-2 text-xs font-semibold text-slate-900 bg-white hover:bg-slate-100 rounded-lg transition-colors\"\n          >\n            Vue Cartes Visuelles\n          </button>\n          <button\n            onClick={() => {\n              setViewMode(\'kanban\');\n              setActiveTab(\'inventory\');\n            }}\n            className=\"px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors\"\n          >\n            Vue Tableau Kanban\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
