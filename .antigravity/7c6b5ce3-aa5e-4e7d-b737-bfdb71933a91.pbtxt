  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport {\n  LayoutDashboard,\n  Boxes,\n  ArrowLeftRight,\n  FileSpreadsheet,\n  AlertTriangle,\n  PackageCheck,\n  TrendingDown,\n  Layers,\n  Palette,\n  Sparkles,\n} from \'lucide-react\';\nimport { useStock } from \'../context/StockContext\';\nimport { ViewTab, ThemeStyle } from \'../types\';\nimport { THEME_CONFIGS } from \'./ThemeClasses\';\n\nexport const Sidebar: React.FC = () => {\n  const {\n    activeTab,\n    setActiveTab,\n    products,\n    sheetsSync,\n    hasGoogleToken,\n    theme,\n    setTheme,\n  } = useStock();\n\n  const totalProducts = products.length;\n  const lowStockCount = products.filter((p) => p.quantity > 0 && p.quantity <= p.minThreshold).length;\n  const outOfStockCount = products.filter((p) => p.quantity === 0).length;\n\n  const currentTheme = THEME_CONFIGS[theme];\n\n  const navItems: { id: ViewTab; label: string; icon: React.ReactNode; badge?: number | string; badgeColor?: string }[] = [\n    {\n      id: \'dashboard\',\n      label: \'Tableau de bord\',\n      icon: <LayoutDashboard className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'inventory\',\n      label: \'Catalogue & Stocks\',\n      icon: <Boxes className=\"w-4 h-4\" />,\n      badge: lowStockCount + outOfStockCount > 0 ? lowStockCount + outOfStockCount : undefined,\n      badgeColor: outOfStockCount > 0 ? \'text-rose-600 bg-rose-50\' : \'text-amber-600 bg-amber-50\',\n    },\n    {\n      id: \'movements\',\n      label: \'Journal des flux\',\n      icon: <ArrowLeftRight className=\"w-4 h-4\" />,\n    },\n    {\n      id: \'sheets\',\n      label: \'Google Sheets\',\n      icon: <FileSpreadsheet className=\"w-4 h-4\" />,\n      badge: hasGoogleToken ? \'Sync\' : undefined,\n      badgeColor: \'text-emerald-700 bg-emerald-50\',\n    },\n    {\n      id: \'design_system\',\n      label: \'Design & UI Kit\',\n      icon: <Palette className=\"w-4 h-4 text-indigo-600\" />,\n      badge: \'4 Th\303\250mes\',\n      badgeColor: \'text-indigo-700 bg-indigo-50 font-semibold\',\n    },\n  ];\n\n  return (\n    <aside className=\"w-64 bg-white border-r border-slate-200 flex flex-col shrink-0 select-none\">\n      {/* Brand Header */}\n      <div className=\"h-16 flex items-center px-6 border-b border-slate-200\">\n        <div className=\"flex items-center gap-3\">\n          <div\n            className=\"w-8 h-8 rounded-lg flex items-center justify-center text-white shadow-xs\"\n            style={{ backgroundColor: currentTheme.accentColor }}\n          >\n            <Layers className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <span className=\"text-base font-bold tracking-tight text-slate-900 block leading-tight\">\n              StockFlow\n            </span>\n            <span className=\"text-[11px] text-slate-500 tracking-normal block truncate max-w-[140px]\">\n              {currentTheme.name}\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Navigation Links */}\n      <nav className=\"p-3 space-y-1 flex-1 overflow-y-auto\">\n        <div className=\"px-3 py-2 text-[11px] font-semibold text-slate-400 uppercase tracking-wider\">\n          Gestion & Design\n        </div>\n        {navItems.map((item) => {\n          const isActive = activeTab === item.id;\n          return (\n            <button\n              key={item.id}\n              onClick={() => setActiveTab(item.id)}\n              className={`w-full flex items-center justify-between px-3 py-2 text-sm font-medium rounded-lg transition-colors text-left ${\n                isActive\n                  ? \'bg-blue-50 text-blue-700 font-semibold\'\n                  : \'text-slate-600 hover:text-slate-900 hover:bg-slate-50\'\n              }`}\n            >\n              <div className=\"flex items-center gap-3\">\n                <span className={isActive ? \'text-blue-600\' : \'text-slate-400\'}>\n                  {item.icon}\n                </span>\n                <span>{item.label}</span>\n              </div>\n              {item.badge !== undefined && (\n                <span\n                  className={`text-[10px] font-mono px-1.5 py-0.5 rounded ${item.badgeColor}`}\n                >\n                  {item.badge}\n                </span>\n              )}\n            </button>\n          );\n        })}\n\n        {/* Design Switcher Quick Section */}\n        <div className=\"pt-4 mt-3 border-t border-slate-100 px-3\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-[11px] font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1\">\n              <Sparkles className=\"w-3 h-3 text-amber-500\" />\n              Style Visuel\n            </span>\n            <button\n              onClick={() => setActiveTab(\'design_system\')}\n              className=\"text-[10px] text-blue-600 hover:underline\"\n            >\n              D\303\251tails\n            </button>\n          </div>\n          <div className=\"grid grid-cols-2 gap-1.5\">\n            {(Object.keys(THEME_CONFIGS) as ThemeStyle[]).map((key) => {\n              const cfg = THEME_CONFIGS[key];\n              const isSelected = theme === key;\n              return (\n                <button\n                  key={key}\n                  onClick={() => setTheme(key)}\n                  className={`p-2 rounded-lg border text-left transition-all ${\n                    isSelected\n                      ? \'border-blue-600 bg-blue-50/70 text-blue-900 font-semibold shadow-2xs\'\n                      : \'border-slate-200 text-slate-600 hover:bg-slate-50\'\n                  }`}\n                >\n                  <div className=\"flex items-center gap-1.5 mb-1\">\n                    <span\n                      className=\"w-2 h-2 rounded-full shrink-0\"\n                      style={{ backgroundColor: cfg.accentColor }}\n                    />\n                    <span className=\"text-[11px] truncate leading-none\">\n                      {cfg.name.split(\' \')[0]}\n                    </span>\n                  </div>\n                  <span className=\"text-[9px] text-slate-400 block truncate leading-none\">\n                    {cfg.subtitle.split(\'&\')[0]}\n                  </span>\n                </button>\n              );\n            })}\n          </div>\n        </div>\n      </nav>\n\n      {/* Quick Health Summary */}\n      <div className=\"p-3 mx-3 mb-2 bg-slate-50 rounded-xl border border-slate-200/80\">\n        <div className=\"text-xs font-semibold text-slate-800 mb-1.5 flex items-center justify-between\">\n          <span>Sant\303\251 du Stock</span>\n          <span className=\"text-slate-500 font-mono tabular-nums text-[11px]\">\n            {totalProducts} r\303\251f.\n          </span>\n        </div>\n        <div className=\"space-y-1 text-xs\">\n          <div className=\"flex items-center justify-between text-slate-600 text-[11px]\">\n            <span className=\"flex items-center gap-1.5\">\n              <PackageCheck className=\"w-3 h-3 text-emerald-600\" />\n              <span>Conformes</span>\n            </span>\n            <span className=\"font-mono tabular-nums font-semibold text-slate-800\">\n              {totalProducts - (lowStockCount + outOfStockCount)}\n            </span>\n          </div>\n          <div className=\"flex items-center justify-between text-slate-600 text-[11px]\">\n            <span className=\"flex items-center gap-1.5\">\n              <AlertTriangle className=\"w-3 h-3 text-amber-500\" />\n              <span>Seuil critique</span>\n            </span>\n            <span className=\"font-mono tabular-nums font-semibold text-amber-700\">\n              {lowStockCount}\n            </span>\n          </div>\n          <div className=\"flex items-center justify-between text-slate-600 text-[11px]\">\n            <span className=\"flex items-center gap-1.5\">\n              <TrendingDown className=\"w-3 h-3 text-rose-500\" />\n              <span>Ruptures</span>\n            </span>\n            <span className=\"font-mono tabular-nums font-semibold text-rose-700\">\n              {outOfStockCount}\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Sheets Sync Mini Status */}\n      <div className=\"p-3 border-t border-slate-200 text-xs text-slate-500 flex items-center justify-between bg-slate-50/50\">\n        <div className=\"flex items-center gap-2 truncate\">\n          <span\n            className={`w-2 h-2 rounded-full shrink-0 ${\n              hasGoogleToken\n                ? sheetsSync.status === \'error\'\n                  ? \'bg-rose-500\'\n                  : \'bg-emerald-500 animate-pulse\'\n                : \'bg-slate-300\'\n            }`}\n          />\n          <span className=\"truncate text-[11px]\">\n            {hasGoogleToken ? \'Google Sheets actif\' : \'Mode local r\303\251actif\'}\n          </span>\n        </div>\n        <button\n          onClick={() => setActiveTab(\'sheets\')}\n          className=\"text-[11px] font-medium text-blue-600 hover:text-blue-800 hover:underline shrink-0\"\n        >\n          G\303\251rer\n        </button>\n      </div>\n    </aside>\n  );\n};\n"
