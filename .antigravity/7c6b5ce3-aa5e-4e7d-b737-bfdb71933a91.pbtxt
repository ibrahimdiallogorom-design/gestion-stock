            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Prochaines \303\211tapes apr\303\250s Validation"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "D\303\250s que vous aurez valid\303\251 ce plan :"
