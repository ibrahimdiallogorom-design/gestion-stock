            }
            lines {
              text: "\342\224\224\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\230"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "#### Mod\303\250le de Donn\303\251es Cl\303\251"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **`Product`** :"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `id`: identifiant unique"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `sku`: code r\303\251f\303\251rence article (ex: `PRD-RET-001`)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `name`: libell\303\251 du produit"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `category`: cat\303\251gorie (V\303\252tements, \303\211lectronique, Maison, etc.)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `quantity`: stock actuel"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `minThreshold`: seuil d\'alerte critique"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `costPrice`: prix d\'achat HT"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `salePrice`: prix de vente TTC"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `supplier`: fournisseur principal"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `lastUpdated`: horodatage ISO"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **`StockMovement`** :"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `id`: identifiant du mouvement"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `productId`: r\303\251f\303\251rence produit"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `productName`: libell\303\251 snapshot"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `type`: `IN` (r\303\251ception) | `OUT` (vente/d\303\251part) | `ADJUSTMENT` (inventaire) | `RETURN` (retour)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `quantityDelta`: variation (+/-)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - `previousStock`: stock avant"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
