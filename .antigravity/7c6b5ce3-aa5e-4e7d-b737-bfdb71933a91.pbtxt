      id: "call_164260"
      name: "write_to_file"
      arguments_json: "{\"Append\":false, \"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport { X, ArrowDownRight, ArrowUpRight, SlidersHorizontal, RotateCcw } from \'lucide-react\';\\nimport { useStock } from \'../context/StockContext\';\\nimport { MovementType } from \'../types\';\\n\\nexport const MovementModal: React.FC = () => {\\n  const {\\n    products,\\n    movementModal,\\n    closeMovementModal,\\n    recordMovement,\\n    currentUser,\\n  } = useStock();\\n\\n  const [selectedProductId, setSelectedProductId] = useState(\'\');\\n  const [type, setType] = useState<MovementType>(\'IN\');\\n  const [quantity, setQuantity] = useState<number>(1);\\n  const [reason, setReason] = useState(\'R\303\251ception commande fournisseur\');\\n  const [operator, setOperator] = useState(\'\');\\n  const [notes, setNotes] = useState(\'\');\\n  const [error, setError] = useState<string | null>(null);\\n\\n  useEffect(() => {\\n    if (movementModal.isOpen) {\\n      const initialId = movementModal.productId || (products[0]?.id ?? \'\');\\n      setSelectedProductId(initialId);\\n      const initialType = movementModal.defaultType || \'IN\';\\n      setType(initialType);\\n      setQuantity(1);\\n      setOperator(currentUser?.displayName || \'Op\303\251rateur Boutique\');\\n      setNotes(\'\');\\n      setError(null);\\n\\n      if (initialType === \'IN\') {\\n        setReason(\'R\303\251ception commande fournisseur\');\\n      } else if (initialType === \'OUT\') {\\n        setReason(\'Vente comptoir boutique\');\\n      } else if (initialType === \'RETURN\') {\\n        setReason(\'Retour client en magasin\');\\n      } else {\\n        setReason(\'Ajustement inventaire physique\');\\n      }\\n    }\\n  }, [movementModal, products, currentUser]);\\n\\n  if (!movementModal.isOpen) return null;\\n\\n  const currentProduct = products.find((p) => p.id === selectedProductId);\\n  const currentStock = currentProduct?.quantity ?? 0;\\n\\n  let newStockPreview = currentStock;\\n  if (type === \'IN\' || type === \'RETURN\') {\\n    newStockPreview = currentStock + (quantity || 0);\\n  } else if (type === \'OUT\') {\\n    newStockPreview = currentStock - (quantity || 0);\\n  } else if (type === \'ADJUSTMENT\') {\\n    newStockPreview = quantity || 0;\\n  }\\n\\n  const handleSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setError(null);\\n\\n    if (!selectedProductId) {\\n      setError(\'Veuillez s\303\251lectionner un article.\');\\n      return;\\n    }\\n\\n    if (quantity <= 0 && type !== \'ADJUSTMENT\') {\\n      setError(\'La quantit\303\251 doit \303\252tre sup\303\251rieure \303\240 z\303\251ro.\');\\n      return;\\n    }\\n\\n    if (type === \'OUT\' && quantity > currentStock) {\\n      setError(`Quantit\303\251 insuffisante en stock (${currentStock} disponible).`);\\n      return;\\n    }\\n\\n    recordMovement(\\n      selectedProductId,\\n      type,\\n      quantity,\\n      reason,\\n      operator || \'Op\303\251rateur Boutique\',\\n      notes\\n    );\\n    closeMovementModal();\\n  };\\n\\n  const reasonsByType: Record<MovementType, string[]> = {\\n    IN: [\\n      \'R\303\251ception commande fournisseur\',\\n      \'R\303\251assort planifi\303\251\',\\n      \'Transfert inter-d\303\251p\303\264t entrant\',\\n      \'Production interne\',\\n    ],\\n    OUT: [\\n      \'Vente comptoir boutique\',\\n      \'Commande e-commerce exp\303\251di\303\251e\',\\n      \'Casse ou avarie constat\303\251e\',\\n      \'P\303\251remption ou d\303\251marque inconnue\',\\n      \'\303\211chantillon ou dotation\',\\n    ],\\n    ADJUSTMENT: [\\n      \'Ajustement inventaire physique\',\\n      \'R\303\251gularisation suite \303\240 \303\251cart de comptage\',\\n      \'Correction suite \303\240 erreur de r\303\251f\303\251rence\',\\n    ],\\n    RETURN: [\\n      \'Retour client en magasin (\303\251change/remboursement)\',\\n      \'Retour de pr\303\252t ou d\303\251monstration\',\\n      \'Retour fournisseur suite \303\240 refus\',\\n    ],\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4\\\">\\n      <div className=\\\"bg-white rounded-2xl border border-slate-200 shadow-xl max-w-lg w-full overflow-hidden animate-in fade-in zoom-in-95 duration-150\\\">\\n        {/* Modal Header */}\\n        <div className=\\\"px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50/50\\\">\\n          <div>\\n            <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n              Enregistrer un Mouvement de Stock\\n            </h2>\\n            <p className=\\\"text-xs text-slate-500 mt-0.5\\\">\\n              Tra\303\247abilit\303\251 imm\303\251diate avec mise \303\240 jour du niveau d\'inventaire\\n            </p>\\n          </div>\\n          <button\\n            onClick={closeMovementModal}\\n            className=\\\"text-slate-400 hover:text-slate-600 p-1 rounded-lg\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Modal Form */}\\n        <form onSubmit={handleSubmit} className=\\\"p-6 space-y-4 text-xs\\\">\\n          {error && (\\n            <div className=\\\"p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-lg font-medium\\\">\\n              {error}\\n            </div>\\n          )}\\n\\n          {/* Movement Type Selector */}\\n          <div>\\n            <label className=\\\"font-semibold text-slate-700 block mb-1.5\\\">\\n              Type d\'op\303\251ration\\n            </label>\\n            <div className=\\\"grid grid-cols-4 gap-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setType(\'IN\');\\n                  setReason(reasonsByType.IN[0]);\\n                }}\\n                className={`py-2 px-2 text-center rounded-lg border font-medium flex flex-col items-center gap-1 transition-all ${\\n                  type === \'IN\'\\n                    ? \'border-emerald-600 bg-emerald-50 text-emerald-800 ring-1 ring-emerald-600\'\\n                    : \'border-slate-200 text-slate-600 hover:bg-slate-50\'\\n                }`}\\n              >\\n                <ArrowDownRight className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                <span>Entr\303\251e</span>\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setType(\'OUT\');\\n                  setReason(reasonsByType.OUT[0]);\\n                }}\\n                className={`py-2 px-2 text-center rounded-lg border font-medium flex flex-col items-center gap-1 transition-all ${\\n                  type === \'OUT\'\\n                    ? \'border-rose-600 bg-rose-50 text-rose-800 ring-1 ring-rose-600\'\\n                    : \'border-slate-200 text-slate-600 hover:bg-slate-50\'\\n                }`}\\n              >\\n                <ArrowUpRight className=\\\"w-4 h-4 text-rose-600\\\" />\\n                <span>Sortie</span>\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setType(\'RETURN\');\\n                  setReason(reasonsByType.RETURN[0]);\\n                }}\\n                className={`py-2 px-2 text-center rounded-lg border font-medium flex flex-col items-center gap-1 transition-all ${\\n                  type === \'RETURN\'\\n                    ? \'border-amber-600 bg-amber-50 text-amber-800 ring-1 ring-amber-600\'\\n                    : \'border-slate-200 text-slate-600 hover:bg-slate-50\'\\n                }`}\\n              >\\n                <RotateCcw className=\\\"w-4 h-4 text-amber-600\\\" />\\n                <span>Retour</span>\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setType(\'ADJUSTMENT\');\\n                  setReason(reasonsByType.ADJUSTMENT[0]);\\n                }}\\n                className={`py-2 px-2 text-center rounded-lg border font-medium flex flex-col items-center gap-1 transition-all ${\\n                  type === \'ADJUSTMENT\'\\n                    ? \'border-indigo-600 bg-indigo-50 text-indigo-800 ring-1 ring-indigo-600\'\\n                    : \'border-slate-200 text-slate-600 hover:bg-slate-50\'\\n                }`}\\n              >\\n                <SlidersHorizontal className=\\\"w-4 h-4 text-indigo-600\\\" />\\n                <span>Ajustement</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Product Select */}\\n          <div>\\n            <label className=\\\"font-semibold text-slate-700 block mb-1\\\">\\n              Article concern\303\251\\n            </label>\\n            <select\\n              value={selectedProductId}\\n              onChange={(e) => setSelectedProductId(e.target.value)}\\n              className=\\\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 text-slate-900\\\"\\n            >\\n              {products.map((p) => (\\n                <option key={p.id} value={p.id}>\\n                  {p.name} ({p.sku}) \342\200\224 Stock actuel : {p.quantity}\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n\\n          {/* Quantity & Stock Preview */}\\n          <div className=\\\"grid grid-cols-2 gap-4\\\">\\n            <div>\\n              <label className=\\\"font-semibold text-slate-700 block mb-1\\\">\\n                {type === \'ADJUSTMENT\' ? \'Nouveau stock r\303\251el\' : \'Quantit\303\251 du mouvement\'}\\n              </label>\\n              <input\\n                type=\\\"number\\\"\\n                min={type === \'ADJUSTMENT\' ? 0 : 1}\\n                value={quantity}\\n                onChange={(e) => setQuantity(Number(e.target.value))}\\n                className=\\\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 font-mono tabular-nums text-slate-900\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"font-semibold text-slate-500 block mb-1\\\">\\n                Pr\303\251visualisation Stock\\n              </label>\\n              <div className=\\\"px-3 py-2 bg-slate-100 rounded-lg text-slate-700 font-mono tabular-nums flex items-center justify-between border border-slate-200/60\\\">\\n                <span>{currentStock}</span>\\n                <span className=\\\"text-slate-400\\\">\342\206\222</span>\\n                <span\\n                  className={`font-bold ${\\n                    newStockPreview < (currentProduct?.minThreshold ?? 0)\\n                      ? \'text-rose-600\'\\n                      : \'text-emerald-700\'\\n                  }`}\\n                >\\n                  {newStockPreview}\\n                </span>\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Reason */}\\n          <div>\\n            <label className=\\\"font-semibold text-slate-700 block mb-1\\\">\\n              Motif de l\'op\303\251ration\\n            </label>\\n            <div className=\\\"space-y-1.5\\\">\\n              <input\\n                type=\\\"text\\\"\\n                value={reason}\\n                onChange={(e) => setReason(e.target.value)}\\n                placeholder=\\\"Pr\303\251cisez le motif...\\\"\\n                className=\\\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 text-slate-900\\\"\\n              />\\n              <div className=\\\"flex flex-wrap gap-1\\\">\\n                {reasonsByType[type].map((r) => (\\n                  <button\\n                    key={r}\\n                    type=\\\"button\\\"\\n                    onClick={() => setReason(r)}\\n                    className=\\\"text-[10px] text-slate-500 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 px-2 py-0.5 rounded transition-colors\\\"\\n                  >\\n                    {r}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Operator and Notes */}\\n          <div className=\\\"grid grid-cols-2 gap-4\\\">\\n            <div>\\n              <label className=\\\"font-semibold text-slate-700 block mb-1\\\">\\n                Op\303\251rateur / Vendeur\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                value={operator}\\n                onChange={(e) => setOperator(e.target.value)}\\n                className=\\\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 text-slate-900\\\"\\n              />\\n            </div>\\n            <div>\\n              <label className=\\\"font-semibold text-slate-700 block mb-1\\\">\\n                Commentaire (optionnel)\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                value={notes}\\n                onChange={(e) => setNotes(e.target.value)}\\n                placeholder=\\\"R\303\251f BL, N\302\260 de ticket...\\\"\\n                className=\\\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 text-slate-900\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          {/* Actions */}\\n          <div className=\\\"pt-4 border-t border-slate-100 flex items-center justify-end gap-3\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={closeMovementModal}\\n              className=\\\"px-4 py-2 text-slate-600 hover:text-slate-900 font-medium rounded-lg\\\"\\n            >\\n              Annuler\\n            </button>\\n            <button\\n              type=\\\"submit\\\"\\n              className=\\\"px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-xs shadow-blue-600/20 transition-colors\\\"\\n            >\\n              Valider le mouvement\\n            </button>\\n          </div>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Composant MovementModal pour enregistrer les entr\303\251es, sorties, retours et ajustements de stock\", \"Overwrite\":true, \"TargetFile\":\"/src/components/MovementModal.tsx\", \"toolAction\":\"Creating movement modal\", \"toolSummary\":\"Create MovementModal component\"}"
