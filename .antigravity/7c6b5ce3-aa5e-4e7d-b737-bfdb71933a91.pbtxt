    content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React from \'react\';\nimport { StockProvider, useStock } from \'./context/StockContext\';\nimport { Sidebar } from \'./components/Sidebar\';\nimport { TopBar } from \'./components/TopBar\';\nimport { DashboardView } from \'./components/DashboardView\';\nimport { InventoryView } from \'./components/InventoryView\';\nimport { MovementsView } from \'./components/MovementsView\';\nimport { SheetsSyncView } from \'./components/SheetsSyncView\';\nimport { MovementModal } from \'./components/MovementModal\';\nimport { ProductModal } from \'./components/ProductModal\';\nimport { ConfirmModal } from \'./components/ConfirmModal\';\n\nconst AppContent: React.FC = () => {\n  const { activeTab } = useStock();\n\n  return (\n    <div className=\"flex h-screen w-screen overflow-hidden bg-slate-50 text-slate-900 font-sans antialiased selection:bg-blue-100 selection:text-blue-900\">\n      {/* 256px Workspace Sidebar */}\n      <Sidebar />\n\n      {/* Main Content Area */}\n      <div className=\"flex-1 flex flex-col min-w-0 overflow-hidden\">\n        {/* Contextual Top Bar */}\n        <TopBar />\n\n        {/* Viewport Content */}\n        <main className=\"flex-1 overflow-y-auto\">\n          {activeTab === \'dashboard\' && <DashboardView />}\n          {activeTab === \'inventory\' && <InventoryView />}\n          {activeTab === \'movements\' && <MovementsView />}\n          {activeTab === \'sheets\' && <SheetsSyncView />}\n        </main>\n      </div>\n\n      {/* Action Modals */}\n      <MovementModal />\n      <ProductModal />\n      <ConfirmModal />\n    </div>\n  );\n};\n\nexport default function App() {\n  return (\n    <StockProvider>\n      <AppContent />\n    </StockProvider>\n  );\n}\n"
    raw_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React from \'react\';\nimport { StockProvider, useStock } from \'./context/StockContext\';\nimport { Sidebar } from \'./components/Sidebar\';\nimport { TopBar } from \'./components/TopBar\';\nimport { DashboardView } from \'./components/DashboardView\';\nimport { InventoryView } from \'./components/InventoryView\';\nimport { MovementsView } from \'./components/MovementsView\';\nimport { SheetsSyncView } from \'./components/SheetsSyncView\';\nimport { MovementModal } from \'./components/MovementModal\';\nimport { ProductModal } from \'./components/ProductModal\';\nimport { ConfirmModal } from \'./components/ConfirmModal\';\n\nconst AppContent: React.FC = () => {\n  const { activeTab } = useStock();\n\n  return (\n    <div className=\"flex h-screen w-screen overflow-hidden bg-slate-50 text-slate-900 font-sans antialiased selection:bg-blue-100 selection:text-blue-900\">\n      {/* 256px Workspace Sidebar */}\n      <Sidebar />\n\n      {/* Main Content Area */}\n      <div className=\"flex-1 flex flex-col min-w-0 overflow-hidden\">\n        {/* Contextual Top Bar */}\n        <TopBar />\n\n        {/* Viewport Content */}\n        <main className=\"flex-1 overflow-y-auto\">\n          {activeTab === \'dashboard\' && <DashboardView />}\n          {activeTab === \'inventory\' && <InventoryView />}\n          {activeTab === \'movements\' && <MovementsView />}\n          {activeTab === \'sheets\' && <SheetsSyncView />}\n        </main>\n      </div>\n\n      {/* Action Modals */}\n      <MovementModal />\n      <ProductModal />\n      <ConfirmModal />\n    </div>\n  );\n};\n\nexport default function App() {\n  return (\n    <StockProvider>\n      <AppContent />\n    </StockProvider>\n  );\n}\n"
